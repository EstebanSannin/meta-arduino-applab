[Unit]
Description=Arduino App CLI daemon (App Lab)
After=network-online.target docker.service arduino-router.service arduino-app-cli-setup.service
Wants=network-online.target docker.service arduino-router.service
Requires=arduino-app-cli-setup.service

[Service]
ExecStart=/usr/bin/arduino-app-cli daemon --port 8800 --log-level error
User=@ARDUINO_USER@
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
