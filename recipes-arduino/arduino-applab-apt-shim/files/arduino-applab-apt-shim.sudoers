# arduino-app-cli "system update" commands, answered by the apt stand-ins.
Defaults:#1000 env_keep += "DEBIAN_FRONTEND NEEDRESTART_MODE"
#1000 ALL=(ALL) NOPASSWD: /usr/local/bin/apt-get update, /usr/local/bin/apt-get install --only-upgrade -y *, /usr/local/bin/apt-get clean -y, /usr/local/bin/apt-get install --assume-no non-existent-package-probe, /usr/local/bin/apt-get install -y *, /usr/local/bin/dpkg --configure -a, /usr/local/bin/needrestart -r a
